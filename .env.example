# ---- Server ----
PORT=3000
# true = try everything before WhatsApp is connected: a Test tab lets you send
# messages "as" a customer, and nothing is ever sent on WhatsApp.
TEST_MODE=false
# Shared secret the Founder Inbox PWA must send as: Authorization: Bearer <INBOX_API_KEY>
INBOX_API_KEY=change-this-to-a-long-random-string

# ---- MongoDB ----
# If you're plugging this into your existing backend, reuse that same MONGODB_URI/connection.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/thakar_crm

# ---- WhatsApp Cloud API (Meta for Developers > your app > WhatsApp > API Setup) ----
WHATSAPP_TOKEN=your-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id
WHATSAPP_API_VERSION=v20.0
# You choose this string yourself when you set up the webhook in Meta's dashboard - any random string works
WHATSAPP_VERIFY_TOKEN=choose-a-verify-token
# App Secret (Meta app > Settings > Basic). Used to verify the X-Hub-Signature-256
# header so forged webhook POSTs are rejected. STRONGLY recommended in production -
# if left blank, incoming webhooks are NOT authenticated (a warning is logged).
WHATSAPP_APP_SECRET=your-app-secret

# Your own WhatsApp number (with country code, no +, e.g. 919876543210) - where SLA reminders get sent
FOUNDER_PHONE=91XXXXXXXXXX

# ---- Shopify Admin API ----
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-07
# Option A (recommended) - app made in the Shopify Dev Dashboard (dev.shopify.com).
# Use its Client ID + Client secret; the server fetches a fresh access token
# automatically every 24h. The app and the store must be in the same organization.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Option B - custom app made in the store admin (Settings > Apps > Develop apps).
# Paste its permanent Admin API access token instead, and leave Option A blank.
SHOPIFY_ADMIN_API_TOKEN=

# ---- Ticket automation ----
# Hours a ticket can sit unresolved before you get pinged on WhatsApp
SLA_HOURS=6

# ---- Instant acknowledgments (messages the app can't answer itself) ----
# Hours before the same kind of acknowledgment is sent to a customer again, and
# how long the app stays quiet after you've replied to them yourself.
ACK_COOLDOWN_HOURS=12
# Optional: your shop's website. Added as a menu link to replies to product questions.
STORE_URL=

# ---- AI answers from your website info (optional, bring your own model) ----
# General questions (delivery, stores, heating, products, prices...) get a real answer,
# using only src/knowledge/thakar-kitchen.md + your live Shopify product list. Anything
# not covered gets the normal acknowledgment and waits for you. No key = AI answers off.
#
# Claude:            AI_PROVIDER=anthropic, AI_MODEL=claude-opus-5 (or claude-sonnet-5,
#                    claude-haiku-4-5), AI_API_KEY from console.anthropic.com
# OpenAI-compatible: AI_PROVIDER=openai, AI_BASE_URL=<provider's API address>, AI_MODEL, AI_API_KEY
#                    e.g. OpenAI https://api.openai.com/v1
#                         Gemini https://generativelanguage.googleapis.com/v1beta/openai
#                         DeepSeek https://api.deepseek.com/v1
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5
AI_API_KEY=
AI_BASE_URL=

# ---- CRM: automatic customer status (New / Returning / VIP) ----
# Worked out from Shopify order history - no manual tagging. Tune if your
# order volumes or basket sizes change.
CRM_RETURNING_ORDERS=2
CRM_VIP_ORDERS=5
CRM_VIP_SPEND=5000
